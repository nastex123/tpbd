# TPBD Climate Engine Environment Variables
# Copy this file to .env and fill in the values

# NASA Earthdata Login Credentials (for AppEEARS / Harmony / earthaccess)
EARTHDATA_USERNAME=your_username_here
EARTHDATA_PASSWORD=your_password_here
EARTHDATA_TOKEN=your_earthdata_bearer_token_here

# Climate Engine Server Settings
PORT=8000
HOST=127.0.0.1
DEBUG=true

# Cache settings
CACHE_DB_PATH=data/cache/tpbd_cache.db
