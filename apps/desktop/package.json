{
  "name": "tpbd-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test:globe": "node --experimental-strip-types --test src/components/globe/trendLine.test.ts src/components/globe/seriesComparison.test.ts src/components/globe/temporalPeriod.test.ts src/components/globe/historyTimeline.test.ts src/components/globe/investigationReportData.test.ts src/components/globe/teleconnectionComparison.test.ts src/components/copilot/copilotAudio.test.ts",
    "test:local-api": "node --test electron/local-api.test.mjs",
    "test:investigations": "node --experimental-strip-types --test src/stores/investigations.test.ts",
    "desktop": "electron . --dev",
    "start": "electron ."
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-globe.gl": "^2.38.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "electron": "^45.3.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
